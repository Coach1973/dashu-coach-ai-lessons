<script>
(function(){
"use strict";
/* ---------- 小工具 ---------- */
var $=function(s,c){return (c||document).querySelector(s);};
var $$=function(s,c){return Array.prototype.slice.call((c||document).querySelectorAll(s));};
function lsGet(k,d){try{var v=localStorage.getItem(k);return v===null?d:JSON.parse(v);}catch(e){return d;}}
var LS_FULL_MSG='瀏覽器空間不足，可先刪除部分舊照片或用無照片留言';
function lsSet(k,v){
  try{localStorage.setItem(k,JSON.stringify(v));return true;}
  catch(e){
    /* 容量額滿：回退重試一次，仍失敗則 toast 告知，不讓頁面崩潰 */
    try{localStorage.setItem(k,JSON.stringify(v));return true;}
    catch(e2){toast(LS_FULL_MSG);return false;}
  }
}
var toastEl=$('#toast'),toastTimer=null;
function toast(msg){
  toastEl.textContent=msg;toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(function(){toastEl.classList.remove('show');},2800);
}

/* ---------- 捲動淡入 ---------- */
var io=new IntersectionObserver(function(es){
  es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
},{threshold:.12});
$$('.reveal').forEach(function(el){io.observe(el);});

/* ---------- 導覽漢堡 ---------- */
var burger=$('#burger'),navLinks=$('#navLinks');
burger.addEventListener('click',function(){
  var open=navLinks.classList.toggle('open');
  burger.setAttribute('aria-expanded',open?'true':'false');
  burger.textContent=open?'✕':'☰';
});
$$('#navLinks a').forEach(function(a){a.addEventListener('click',function(){
  navLinks.classList.remove('open');burger.setAttribute('aria-expanded','false');burger.textContent='☰';
});});

/* ---------- Hero 數字遞增 ---------- */
function baseStats(){
  var notes=lsGet('tut_notes',[]);
  return {alumni:1268, notes:842+notes.length+serverNotes.length};
}
function animateNum(el,to){
  var from=parseInt(el.textContent.replace(/\D/g,''),10)||0;
  var dur=1600,t0=null;
  function step(ts){
    if(!t0)t0=ts;
    var p=Math.min((ts-t0)/dur,1);
    var ease=1-Math.pow(1-p,3);
    el.textContent=Math.round(from+(to-from)*ease).toLocaleString('en-US');
    if(p<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function refreshStats(animate){
  var s=baseStats();
  var els=$$('#heroStats .num');
  var vals=[s.alumni,s.notes];
  els.forEach(function(el,i){
    if(animate){animateNum(el,vals[i]);}
    else{el.textContent=vals[i].toLocaleString('en-US');}
  });
}
var statsIO=new IntersectionObserver(function(es){
  es.forEach(function(e){
    if(e.isIntersecting){refreshStats(true);statsIO.unobserve(e.target);}
  });
},{threshold:.4});
statsIO.observe($('#heroStats'));

/* ---------- 圖片淡入（載入完成才顯現，避免閃爍） ---------- */
function bindImgFade(root){
  $$('img[data-fade]',root||document).forEach(function(img){
    if(img.dataset.bound)return;
    img.dataset.bound='1';
    if(img.complete&&img.naturalWidth>0){img.classList.add('loaded');}
    else{img.addEventListener('load',function(){img.classList.add('loaded');});}
  });
}

/* ---------- Lightbox（十景與回憶照片共用） ---------- */
var lbItems=[],lbIdx=0;
function openLightbox(items,idx){
  lbItems=items;lbIdx=idx||0;
  renderLb();
  $('#lightbox').classList.add('show');
  document.body.style.overflow='hidden';
  $('#lbClose').focus();
}
function renderLb(){
  var it=lbItems[lbIdx];if(!it)return;
  $('#lbImg').src=it.src;
  $('#lbImg').alt=it.title||'';
  $('#lbTitle').textContent=it.title||'';
  $('#lbDesc').textContent=it.desc||'';
  $('#lbPrev').style.display=lbItems.length>1?'':'none';
  $('#lbNext').style.display=lbItems.length>1?'':'none';
}
function closeLightbox(){
  $('#lightbox').classList.remove('show');
  document.body.style.overflow='';
  $('#lbImg').src='';
}
function lbStep(d){
  if(lbItems.length<2)return;
  lbIdx=(lbIdx+d+lbItems.length)%lbItems.length;
  renderLb();
}
$('#lbClose').addEventListener('click',closeLightbox);
$('#lbPrev').addEventListener('click',function(){lbStep(-1);});
$('#lbNext').addEventListener('click',function(){lbStep(1);});
$('#lightbox').addEventListener('click',function(e){if(e.target===this)closeLightbox();});
document.addEventListener('keydown',function(e){
  if(!$('#lightbox').classList.contains('show'))return;
  if(e.key==='Escape')closeLightbox();
  else if(e.key==='ArrowLeft')lbStep(-1);
  else if(e.key==='ArrowRight')lbStep(1);
});

/* ---------- Section 2 時光走廊手風琴 ---------- */
$$('#tl .tl-node').forEach(function(node){
  var card=$('.tl-card',node);
  function toggle(){
    var willOpen=!node.classList.contains('open');
    $$('#tl .tl-node').forEach(function(n){
      n.classList.remove('open');
      $('.tl-card',n).setAttribute('aria-expanded','false');
    });
    if(willOpen){node.classList.add('open');card.setAttribute('aria-expanded','true');}
  }
  card.addEventListener('click',toggle);
  var tlImg=$('.tl-media img',node);
  if(tlImg){tlImg.addEventListener('click',function(e){
    e.stopPropagation();
    var nodes=$$('#tl .tl-node');
    openLightbox(nodes.map(function(n){
      return {src:$('.tl-media img',n).getAttribute('src'),title:$('.yr',n).textContent+'　'+$('h3',n).textContent,desc:$('.tl-story',n).textContent};
    }),nodes.indexOf(node));
  });}
  card.addEventListener('keydown',function(e){
    if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle();}
  });
});

bindImgFade(document);

/* ---------- Section 4 回憶相簿牆 ---------- */
var SEED_NOTES=[
  {id:'seed1',name:'旗袍課幽靈車手',year:'1982 屆',color:'yellow',txt:'家政科二年級，旗袍課縫到半夜，但成品穿上那天全都值得。',baseEcho:38},
  {id:'seed2',name:'306 寢室全體',year:'2008 屆',color:'mint',txt:'紅樓宿舍半夜真的有椅子聲，我們整間寢室沒人敢去廁所。',baseEcho:47},
  {id:'seed3',name:'阿凱',year:'2015 屆',color:'pink',txt:'南應之心前第一次告白，現在小孩都兩歲了。',baseEcho:26},
  {id:'seed4',name:'設計系爆肝王',year:'2012 屆',color:'yellow',txt:'設計大樓四樓的燈，是陪我熬過畢業展的那盞。評圖前一晚大家互相遞咖啡，那味道現在聞到還會想哭。',baseEcho:52},
  {id:'seed5',name:'鳳凰花下的學姊',year:'1996 屆',color:'pink',txt:'畢業那天鳳凰花開得剛好，我們沿著花道拍照，學妹們在旁邊唱離別歌，哭得比我們還慘。',baseEcho:41},
  {id:'seed6',name:'餐廳常客小陳',year:'2019 屆',color:'mint',txt:'學生餐廳的排骨飯加一顆滷蛋，是我一個月生活費的支柱。畢業後吃過很多家，都不是那個味道。',baseEcho:33}
];
var MEMWALL_API='https://event.bymyway.com/api/memwall/tut-memory/notes';
var serverNotes=[];
var userNotes=lsGet('tut_notes',[]);
/* 舊版純文字留言相容：無 id 者補發 id 並遷移回存 */
(function(){
  var needMigrate=false;
  userNotes.forEach(function(n,i){
    if(!n||typeof n!=='object')return;
    if(!n.id){n.id='u'+(n.ts||Date.now()).toString(36)+'x'+i;needMigrate=true;}
  });
  if(needMigrate)lsSet('tut_notes',userNotes);
})();
var echoMap=lsGet('tut_echoes',{});
var sortNew=true;
/* 自己送出、還沒審核通過的留言只顯示給自己；已通過的以伺服器版本為準，不重複 */
function myPending(){
  var ok={};serverNotes.forEach(function(n){ok[n.id]=1;});
  return userNotes.filter(function(n){return !(n.serverId&&ok[n.serverId]);});
}
function allNotes(){return myPending().concat(serverNotes,SEED_NOTES);}
function loadServerNotes(){
  fetch(MEMWALL_API).then(function(r){return r.json();}).then(function(d){
    if(!d||!d.ok)return;
    serverNotes=d.notes.map(function(n){
      return {id:n.id,name:n.name,year:n.year,color:n.color,txt:n.txt,
        photo:n.photo?('https://event.bymyway.com'+n.photo):null,
        ts:Date.parse((n.created_at||'').replace(' ','T'))||0,baseEcho:0};
    });
    renderNotes();refreshStats(false);
  }).catch(function(){});
}
function echoCount(n){return (n.baseEcho||0)+(echoMap[n.id]?1:0);}
function escapeHTML(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function noteHTML(n,isNew){
  var pend=n.pending?'<span class="ncard-pending">⏳ 審核中・目前只有你看得到</span>':'';
  var sig='<p class="ncard-sig">— '+escapeHTML(n.name||'匿名校友')+' · '+escapeHTML(n.year||'')+'</p>';
  var foot='<div class="ncard-foot"><button type="button" class="btn-echo'+(echoMap[n.id]?' on':'')+
    '" data-echo="'+n.id+'" aria-pressed="'+(echoMap[n.id]?'true':'false')+'">♡ <span>'+echoCount(n)+'</span> 共鳴</button></div>';
  if(n.photo){
    return '<article class="ncard'+(isNew?' new':'')+'" data-id="'+n.id+'">'+
      '<div class="ncard-photo" role="button" tabindex="0" aria-label="放大檢視這張回憶照片">'+
      '<img src="'+n.photo+'" alt="'+escapeHTML(n.name||'匿名校友')+'上傳的回憶照片"></div>'+
      pend+'<p class="ncard-txt">'+escapeHTML(n.txt)+'</p>'+sig+foot+'</article>';
  }
  return '<article class="ncard plain note-'+(n.color||'yellow')+(isNew?' new':'')+'" data-id="'+n.id+'">'+
    pend+'<p class="ncard-txt">'+escapeHTML(n.txt)+'</p>'+sig+foot+'</article>';
}
function renderNotes(highlightId){
  var grid=$('#notesGrid');
  var list;
  if(sortNew){list=myPending().slice().reverse().concat(serverNotes,SEED_NOTES);}
  else{list=allNotes().sort(function(a,b){return echoCount(b)-echoCount(a)||((b.ts||0)-(a.ts||0));});}
  grid.innerHTML=list.map(function(n){return noteHTML(n,n.id===highlightId);}).join('');
  $$('.btn-echo',grid).forEach(function(b){
    b.addEventListener('click',function(){toggleEcho(b.getAttribute('data-echo'));});
  });
  $$('.ncard-photo',grid).forEach(function(p){
    function open(){openNoteLb(p.parentNode.getAttribute('data-id'));}
    p.addEventListener('click',open);
    p.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}
    });
  });
}
function toggleEcho(id){
  if(echoMap[id])delete echoMap[id];else echoMap[id]=1;
  lsSet('tut_echoes',echoMap);
  renderNotes();
}
function openNoteLb(id){
  var photoNotes=allNotes().filter(function(n){return n.photo;});
  if(!photoNotes.length)return;
  var idx=0;
  photoNotes.forEach(function(n,i){if(n.id===id)idx=i;});
  openLightbox(photoNotes.map(function(n){
    return {src:n.photo,title:'— '+(n.name||'匿名校友')+' · '+(n.year||''),desc:n.txt};
  }),idx);
}
function setSortUI(){
  $('#sortNew').classList.toggle('on',sortNew);
  $('#sortHot').classList.toggle('on',!sortNew);
  $('#sortNew').setAttribute('aria-pressed',sortNew?'true':'false');
  $('#sortHot').setAttribute('aria-pressed',!sortNew?'true':'false');
}
$('#sortNew').addEventListener('click',function(){sortNew=true;setSortUI();renderNotes();});
$('#sortHot').addEventListener('click',function(){sortNew=false;setSortUI();renderNotes();});
setSortUI();
renderNotes();
loadServerNotes();

/* ---------- 照片上傳（canvas 壓縮） ---------- */
var pendingPhoto=null;
var fPhoto=$('#fPhoto'),fileDrop=$('#fileDrop'),filePreview=$('#filePreview');
var MAX_PHOTO_BYTES=1.2*1024*1024;
fileDrop.addEventListener('click',function(){fPhoto.click();});
fileDrop.addEventListener('keydown',function(e){
  if(e.key==='Enter'||e.key===' '){e.preventDefault();fPhoto.click();}
});
fPhoto.addEventListener('change',function(){
  var f=fPhoto.files&&fPhoto.files[0];
  if(!f)return;
  compressImage(f,function(dataUrl,bytes){
    if(!dataUrl){toast('這張照片讀取失敗，請換一張試試');fPhoto.value='';return;}
    if(bytes>MAX_PHOTO_BYTES){toast('這張照片壓縮後還是太大，請換一張試試');fPhoto.value='';return;}
    pendingPhoto=dataUrl;
    $('#fpImg').src=dataUrl;
    $('#fpMeta').textContent='已壓縮至約 '+(bytes/1024).toFixed(0)+' KB，將隨回憶一起貼上牆';
    filePreview.classList.add('show');
  });
});
$('#fpRemove').addEventListener('click',function(){
  pendingPhoto=null;fPhoto.value='';filePreview.classList.remove('show');
});
function compressImage(file,cb){
  var reader=new FileReader();
  reader.onerror=function(){cb(null);};
  reader.onload=function(){
    var img=new Image();
    img.onerror=function(){cb(null);};
    img.onload=function(){
      try{
        var ratio=Math.min(1,1000/Math.max(img.width,img.height));
        var w=Math.max(1,Math.round(img.width*ratio)),h=Math.max(1,Math.round(img.height*ratio));
        var c=document.createElement('canvas');c.width=w;c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        var url=c.toDataURL('image/jpeg',0.75);
        cb(url,Math.round((url.length-(url.indexOf(',')+1))*3/4));
      }catch(e){cb(null);}
    };
    img.src=reader.result;
  };
  reader.readAsDataURL(file);
}

var fText=$('#fText'),charCount=$('#charCount');
fText.addEventListener('input',function(){charCount.textContent=fText.value.length;});
$('#noteForm').addEventListener('submit',function(e){
  e.preventDefault();
  var txt=fText.value.trim();
  if(!txt){toast('先寫點什麼再貼進相簿喔 ✍️');fText.focus();return;}
  var color=($('input[name=noteColor]:checked')||{}).value||'yellow';
  var note={id:'u'+Date.now().toString(36),name:$('#fName').value.trim(),year:$('#fYear').value,
    color:color,txt:txt,ts:Date.now(),baseEcho:0};
  if(pendingPhoto)note.photo=pendingPhoto;
  note.pending=true;
  userNotes.push(note);
  fetch(MEMWALL_API,{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({name:note.name,year:note.year,color:note.color,txt:note.txt,photo:note.photo||''})})
  .then(function(r){return r.json();}).then(function(d){
    if(d&&d.ok){note.serverId=d.id;lsSet('tut_notes',userNotes);}
    else{toast(d&&d.error==='too many'?'送出太多次了，請稍後再試':'暫時送不出去，回憶先貼在你自己的牆上');}
  }).catch(function(){toast('暫時送不出去，回憶先貼在你自己的牆上');});
  /* lsSet 失敗（容量額滿）時已 toast 告知；仍保留在記憶體，頁面不崩潰 */
  lsSet('tut_notes',userNotes);
  sortNew=true;setSortUI();
  renderNotes(note.id);
  this.reset();charCount.textContent='0';$('#cYellow').checked=true;
  pendingPhoto=null;filePreview.classList.remove('show');
  toast('已送出！審核通過後，所有校友都看得到 ✨');
  refreshStats(false);
  var wall=$('#notesGrid');
  wall.scrollIntoView({behavior:'smooth',block:'center'});
});

/* ---------- Section 5 講座主題票選（2026-10-10：先收集願望，不排日期、不報名） ---------- */
var TALKS=[
  {id:'t1',no:'#01',title:'記憶開箱：南應十景票選 LIVE',desc:'十景票選結果現場揭曉，一起倒數誰是南應人心中的 No.1。',tags:['十景現場揭票','校友連線說故事']},
  {id:'t2',no:'#02',title:'從家專到南應：跨越一甲子的女子學校傳奇',desc:'走過一甲子的校園故事，由資深校友親自說給你聽。',tags:['資深校友講古','旗袍課老照片募集']},
  {id:'t3',no:'#03',title:'設計×藝術學院之夜：爆肝人的同學會',desc:'設計人與藝術人的深夜同學會，作品與鬼故事齊飛。',tags:['作品即興接龍','鬼故事大賽']},
  {id:'t4',no:'#04',title:'南應人的商務資源課：校友網絡怎麼用',desc:'把校友網絡變成你的商務籌碼，資源一次看個夠。',tags:['商務團隊資源大公開','一對一職涯媒合']}
];
var POLL_API='/api/works/poll/tut-memory';
var pollCounts={};
var myVotes=lsGet('tut_talk_votes',{});
var voterId=lsGet('tut_voter','');
if(!voterId){
  voterId='v'+Math.random().toString(36).slice(2,12)+Date.now().toString(36);
  lsSet('tut_voter',voterId);
}
function renderTalks(){
  var wrap=$('#talkCards');wrap.innerHTML='';
  TALKS.forEach(function(t){
    var mine=!!myVotes[t.id];
    var n=pollCounts[t.id];
    var cnt=(typeof n==='number')?(n>0?'<b>'+n+'</b> 人想聽':'成為第一個想聽的人'):'&nbsp;';
    var el=document.createElement('article');
    el.className='talk';
    el.innerHTML='<div class="stamp"><span>'+t.no.replace('#','')+'</span></div>'+
      '<div class="no">'+t.no+'</div><h3>《'+t.title+'》</h3><p class="desc">'+t.desc+'</p>'+
      '<div class="tags">'+t.tags.map(function(g){return '<span class="tag">'+g+'</span>';}).join('')+'</div>'+
      '<div class="want-count" id="wc-'+t.id+'">'+cnt+'</div>'+
      '<button class="btn '+(mine?'btn-outline':'btn-primary')+'" id="rb-'+t.id+'"'+(mine?' disabled':'')+'>'+
      (mine?'我想聽這個 ✓':'我想聽這個')+'</button>';
    wrap.appendChild(el);
    $('#rb-'+t.id,el).addEventListener('click',function(){voteTalk(t.id);});
  });
}
function loadPoll(){
  fetch(POLL_API).then(function(r){return r.json();}).then(function(d){
    if(d&&d.ok){pollCounts=d.counts||{};renderTalks();}
  }).catch(function(){});
}
function voteTalk(id){
  if(myVotes[id])return;
  fetch(POLL_API+'/vote',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({option:id,voter:voterId})})
    .then(function(r){return r.json();}).then(function(d){
      if(d&&d.ok){
        myVotes[id]=1;lsSet('tut_talk_votes',myVotes);
        pollCounts=d.counts||pollCounts;renderTalks();
        toast('收到！謝謝您投下想聽的一票 🎉');
      }else{toast((d&&d.error)||'投票沒成功，請稍後再試');}
    }).catch(function(){toast('網路不太穩，請稍後再試');});
}
renderTalks();loadPoll();

$('#wishForm').addEventListener('submit',function(e){
  e.preventDefault();
  var text=$('#wishText').value.trim(),out=$('#wishOut'),btn=$('#wishBtn');
  if(text.length<2){out.textContent='請先寫下您想聽的主題喔';$('#wishText').focus();return;}
  btn.disabled=true;out.textContent='送出中⋯';
  fetch(POLL_API+'/suggest',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({suggestion:text,name:$('#wishName').value.trim(),website:$('#wishWebsite').value})})
    .then(function(r){return r.json();}).then(function(d){
      btn.disabled=false;
      if(d&&d.ok){
        $('#wishText').value='';
        out.textContent='收到了！謝謝您的願望，校友會會參考大家的想法來安排講座 💌';
      }else{out.textContent=(d&&d.error)||'送出沒成功，請稍後再試';}
