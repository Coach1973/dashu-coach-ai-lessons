  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  var HTML={
    ext:function(){return '<p class="soon">敬請期待，龐大資源正在連結中</p>';},
    biz:function(){
      return '<h4>專屬商務團隊資源</h4><p class="rp-sub">目前已有 '+BIZ_TEAM.length+' 位夥伴，之後還會持續增加</p><ol class="biz-list" style="list-style:none">'+
