    }
  };
  function toggle(key,btn){
    var willOpen=openKey!==key;
    bExt.setAttribute('aria-expanded','false');bBiz.setAttribute('aria-expanded','false');
    if(!willOpen){openKey='';panel.hidden=true;return;}
    openKey=key;panel.innerHTML=HTML[key]();panel.hidden=false;
    btn.setAttribute('aria-expanded','true');
    panel.scrollIntoView({behavior:'smooth',block:'nearest'});
  }
  bExt.addEventListener('click',function(){toggle('ext',bExt);});
