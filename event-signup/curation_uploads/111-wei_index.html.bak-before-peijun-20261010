<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>有薇力，新東區｜蔡筱薇競選總部成立大會 11/1（日）09:00</title>
<meta name="description" content="台南市東區市議員候選人蔡筱薇競選總部成立大會：2026 年 11 月 1 日（星期日）上午 9 點，中華東路關帝殿停車場。南應大校友與全台灣的朋友，一起來相挺！">
<meta property="og:title" content="蔡筱薇競選總部成立大會｜11/1（日）上午 9:00">
<meta property="og:description" content="中華東路關帝殿停車場見！有薇力，新東區。">
<meta property="og:image" content="assets/poster.webp">
<meta name="theme-color" content="#2e0d38">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Serif+TC:wght@600;900&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#2e0d38;          /* 深梅紫：主文字與深色區塊 */
  --ink-2:#4a1f57;
  --paper:#fff5ea;        /* 暖奶油紙 */
  --paper-2:#fbe7d4;
  --sun:#ff7a1a;          /* 夕陽橘 */
  --rose:#e8227a;         /* 洋紅 */
  --gold:#ffc65c;
  --muted:#6e5373;
  --line:rgba(46,13,56,.16);
  --sunset:linear-gradient(135deg,#ff8a1f 0%,#ff5a3c 38%,#e8227a 78%,#b8186e 100%);
  --serif:"Noto Serif TC","Songti TC",serif;
  --sans:"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;
  --num:"Anton","Noto Sans TC",sans-serif;
  --wrap:min(1180px,calc(100% - 40px));
  --r:18px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.75;letter-spacing:.02em}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:6px}
.wrap{width:var(--wrap);margin-inline:auto}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:8px 14px;z-index:99}
.skip:focus{left:8px}

/* risograph grain */
.grain{position:relative;isolation:isolate}
.grain::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:1;opacity:.22;mix-blend-mode:multiply;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2 0 0 0 0 .05 0 0 0 0 .25 0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}

/* ---------- NAV ---------- */
.nav{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .25s,box-shadow .25s}
.nav.solid{background:rgba(46,13,56,.92);backdrop-filter:blur(10px);box-shadow:0 1px 0 rgba(255,255,255,.08)}
.nav .wrap{display:flex;align-items:center;gap:22px;height:66px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#fff;font-weight:900;letter-spacing:.08em}
.brand i{width:36px;height:36px;border-radius:50%;background:#fff;color:var(--rose);display:grid;place-items:center;font-style:normal;font-family:var(--serif);font-size:19px}
.nav ul{display:flex;gap:4px;margin:0 0 0 auto;padding:0;list-style:none}
.nav ul a{color:#fff;text-decoration:none;font-size:15px;font-weight:500;padding:8px 11px;border-radius:999px;opacity:.9}
.nav ul a:hover{background:rgba(255,255,255,.14);opacity:1}
.nav .cta{background:#fff;color:var(--ink);text-decoration:none;font-weight:900;padding:9px 18px;border-radius:999px;font-size:15px;white-space:nowrap}
@media (max-width:980px){.nav ul{display:none}.nav .cta{margin-left:auto}}

/* ---------- HERO ---------- */
.hero{background:var(--sunset);color:#fff;overflow:hidden;min-height:100svh;display:flex;align-items:flex-end}
.hero::before{content:"";position:absolute;inset:-40%;z-index:0;
  background:repeating-conic-gradient(from 0deg at 18% 8%,rgba(255,255,255,.13) 0deg 4deg,transparent 4deg 13deg);
  animation:spin 120s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.hero .wrap{position:relative;z-index:2;display:grid;grid-template-columns:1.08fr .92fr;align-items:end;gap:10px;padding-top:96px}
.hero-copy{padding-bottom:72px}
.kicker{display:inline-flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.24em;font-size:15px;background:rgba(46,13,56,.28);padding:6px 16px 6px 6px;border-radius:999px}
.kicker b{background:#fff;color:var(--rose);border-radius:999px;padding:2px 12px;letter-spacing:.1em}
.name{font-family:var(--serif);font-weight:900;font-size:clamp(84px,13.5vw,196px);line-height:.95;margin:22px 0 6px;letter-spacing:.02em;
  text-shadow:6px 6px 0 var(--ink)}
.event-title{font-family:var(--serif);font-weight:900;font-size:clamp(28px,3.6vw,50px);margin:6px 0 0;color:var(--ink);letter-spacing:.08em;line-height:1.2}
.slogan{margin:18px 0 0;font-size:clamp(18px,1.6vw,22px);font-weight:700;max-width:30em}
.slogan span{background:var(--ink);padding:2px 10px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.datebig{display:flex;align-items:flex-end;gap:18px;margin-top:26px}
.datebig .d{font-family:var(--num);font-size:clamp(96px,12vw,170px);line-height:.82;letter-spacing:-.01em}
.datebig .meta{background:var(--ink);padding:12px 18px;border-radius:10px;font-weight:700;line-height:1.5;font-size:17px}
.datebig .meta small{display:block;font-weight:500;opacity:.8;font-size:14px}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 24px;border-radius:999px;font-weight:900;font-size:16px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;letter-spacing:.06em;transition:transform .15s ease,box-shadow .15s ease}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}
.btn-ink{background:var(--ink);color:#fff;box-shadow:0 6px 0 rgba(0,0,0,.18)}
.btn-white{background:#fff;color:var(--ink)}
.btn-ghost{background:transparent;color:#fff;box-shadow:inset 0 0 0 2px rgba(255,255,255,.75)}
.btn svg{width:20px;height:20px;flex:none}
.hero-photo{margin:0;position:relative;align-self:end;justify-self:center;width:min(100%,560px)}
.hero-photo img{width:100%;height:auto;-webkit-mask-image:linear-gradient(to bottom,#000 82%,transparent);mask-image:linear-gradient(to bottom,#000 82%,transparent);filter:drop-shadow(0 30px 40px rgba(46,13,56,.35))}
.hero-photo .badge{position:absolute;left:-6%;top:22%;width:132px;height:132px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;text-align:center;font-weight:900;line-height:1.25;font-size:17px;transform:rotate(-10deg);box-shadow:0 0 0 6px rgba(255,255,255,.25)}
.hero-photo .badge em{display:block;font-style:normal;font-family:var(--num);font-size:40px;color:var(--gold);line-height:1}
@media (max-width:900px){
  .hero{min-height:auto}
  .hero .wrap{grid-template-columns:1fr;padding-top:84px}
  .hero-photo{order:-1;width:min(78%,380px);margin-bottom:-40px}
  .hero-photo .badge{width:104px;height:104px;font-size:14px;left:-14%}
  .hero-photo .badge em{font-size:30px}
  .hero-copy{padding-bottom:48px}
  .name{text-shadow:4px 4px 0 var(--ink)}
}

/* countdown ribbon */
.ribbon{background:var(--ink);color:#fff}
.ribbon .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 30px;padding:22px 0}
.cd{display:flex;gap:8px}
.cd div{min-width:78px;text-align:center;background:rgba(255,255,255,.07);border-radius:12px;padding:8px 6px 6px}
.cd b{display:block;font-family:var(--num);font-size:40px;line-height:1;font-weight:400;font-variant-numeric:tabular-nums;color:var(--gold)}
.cd span{font-size:13px;opacity:.75;letter-spacing:.2em}
.ribbon p{margin:0;font-weight:700;font-size:18px}
.ribbon p small{display:block;font-weight:400;opacity:.7;font-size:14px}

/* ---------- SECTIONS ---------- */
section{position:relative}
.sec{padding:120px 0}
.eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--num);font-size:15px;letter-spacing:.24em;color:var(--rose);text-transform:uppercase}
.eyebrow::before{content:"";width:34px;height:3px;background:var(--rose)}
h2{font-family:var(--serif);font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.15;margin:14px 0 22px;letter-spacing:.04em}
h3{font-family:var(--serif);font-weight:900;letter-spacing:.04em;line-height:1.3}
.lead{font-size:19px;max-width:38em;color:var(--muted)}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.reveal.in{opacity:1;transform:none}

/* event ticket */
.ticket{margin-top:-1px;background:var(--paper-2)}
.ticket-card{display:grid;grid-template-columns:repeat(3,1fr) auto;background:#fff;border-radius:var(--r);box-shadow:0 20px 50px -20px rgba(46,13,56,.35);overflow:hidden;margin-top:40px}
.ticket-card>div{padding:28px 30px;border-right:2px dashed var(--line)}
.ticket-card .lbl{font-size:13px;letter-spacing:.28em;color:var(--rose);font-weight:900}
.ticket-card .val{font-family:var(--serif);font-weight:900;font-size:26px;line-height:1.35;margin-top:4px}
.ticket-card .sub{font-size:14px;color:var(--muted)}
.ticket-card .go{display:flex;align-items:center;justify-content:center;background:var(--sunset);border:0;padding:20px 34px}
.ticket-card .go a{color:#fff;font-weight:900;text-decoration:none;text-align:center;line-height:1.4}
.ticket-card .go a span{display:block;font-family:var(--num);font-size:34px;font-weight:400}
.ticket-note{margin-top:40px;display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start;padding-bottom:80px;max-width:860px}
.ticket-note .seal{width:62px;height:62px;border-radius:50%;background:var(--ink);color:var(--gold);display:grid;place-items:center;font-family:var(--serif);font-weight:900;font-size:26px}
.ticket-note p{margin:0;font-size:18px}
@media (max-width:860px){.ticket-card{grid-template-columns:1fr}.ticket-card>div{border-right:0;border-bottom:2px dashed var(--line)}}

/* story timeline */
.story{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}
.story-side{position:sticky;top:100px;align-self:start}
.quote{margin:36px 0 0;padding:28px 30px;background:var(--ink);color:#fff;border-radius:var(--r)}
.quote q{font-family:var(--serif);font-size:28px;font-weight:900;line-height:1.45;quotes:"「" "」"}
.quote q b{color:var(--gold)}
.quote figcaption{margin-top:12px;font-size:14px;opacity:.75}
.tl{list-style:none;margin:0;padding:0;border-left:3px solid var(--ink)}
.tl li{position:relative;padding:0 0 44px 34px}
.tl li::before{content:"";position:absolute;left:-11px;top:8px;width:19px;height:19px;border-radius:50%;background:var(--paper);border:4px solid var(--rose)}
.tl li.hot::before{background:var(--rose)}
.tl .yr{font-family:var(--num);font-size:30px;line-height:1;color:var(--rose)}
.tl h3{font-size:24px;margin:8px 0 6px}
.tl p{margin:0;color:var(--muted)}
.tl .tag{display:inline-block;margin-top:10px;font-size:13px;font-weight:700;background:var(--ink);color:#fff;padding:3px 12px;border-radius:999px}
@media (max-width:900px){.story{grid-template-columns:1fr;gap:40px}.story-side{position:static}}

/* manifesto */
.manifesto{background:var(--ink);color:#fff;overflow:hidden}
.manifesto .big{font-family:var(--serif);font-weight:900;font-size:clamp(46px,8.6vw,128px);line-height:1.08;margin:18px 0 0;letter-spacing:.03em}
.manifesto .big em{font-style:normal;background:var(--sunset);-webkit-background-clip:text;background-clip:text;color:transparent}
.manifesto .eyebrow{color:var(--gold)}.manifesto .eyebrow::before{background:var(--gold)}
.vals{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.14);margin-top:70px;border-radius:var(--r);overflow:hidden}
.vals div{background:var(--ink);padding:34px 30px}
.vals b{font-family:var(--serif);font-size:40px;font-weight:900;color:var(--gold);display:block;line-height:1.2}
.vals p{margin:10px 0 0;opacity:.85}
.belief{margin-top:56px;font-size:20px;max-width:46em;opacity:.92}
.belief strong{color:var(--gold)}
@media (max-width:760px){.vals{grid-template-columns:1fr}}

/* policy */
.policy-head{display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap}
.blue{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;margin-top:40px}
.zone{position:relative;background:#fff;border-radius:var(--r);padding:34px 34px 30px;box-shadow:0 1px 0 var(--line),0 18px 40px -28px rgba(46,13,56,.45);overflow:hidden}
.zone .no{position:absolute;right:18px;top:-6px;font-family:var(--num);font-size:120px;line-height:1;color:var(--paper-2);z-index:0}
.zone>*{position:relative;z-index:1}
.zone .area{font-size:13px;font-weight:900;letter-spacing:.2em;color:var(--rose)}
.zone h3{font-size:34px;margin:6px 0 4px}
.zone .sub{font-weight:700;margin:0 0 14px}
.zone ul{margin:0;padding-left:1.2em;color:var(--muted);font-size:16px}
.zone li{margin:4px 0}
.welfare{margin-top:70px;background:var(--sunset);color:#fff;border-radius:calc(var(--r) + 6px);padding:46px 44px}
.welfare h3{font-size:32px;margin:0 0 6px}
.welfare>p{margin:0 0 30px;opacity:.92}
.wf{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.wf div{background:rgba(46,13,56,.82);border-radius:14px;padding:22px 20px}
.wf .who{font-size:13px;font-weight:900;letter-spacing:.2em;color:var(--gold)}
.wf b{display:block;font-family:var(--serif);font-size:21px;line-height:1.45;margin-top:8px}
@media (max-width:980px){.wf{grid-template-columns:repeat(2,1fr)}}
@media (max-width:760px){.blue{grid-template-columns:1fr}.wf{grid-template-columns:1fr}.welfare{padding:34px 22px}}

/* footprints (horizontal) */
.steps-sec{background:var(--paper-2)}
.steps{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px 20px 30px max(20px,calc((100% - 1180px)/2));scrollbar-width:thin}
.step{flex:0 0 300px;scroll-snap-align:start;background:#fff;border-radius:var(--r);padding:26px 24px;border-top:6px solid var(--ink);display:flex;flex-direction:column}
.step time{font-family:var(--num);font-size:26px;color:var(--rose);line-height:1}
.step h3{font-size:21px;margin:10px 0 8px}
.step p{margin:0;font-size:15px;color:var(--muted)}
.step.now{background:var(--ink);color:#fff;border-top-color:var(--gold)}
.step.now p{color:rgba(255,255,255,.8)}
.step.now time{color:var(--gold)}
.step.now .pin{margin-top:auto;padding-top:14px;font-weight:900;color:var(--gold)}
.hint{font-size:14px;color:var(--muted);margin-top:4px}

/* charity */
.charity{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;margin-top:40px}
.big-card{background:var(--ink);color:#fff;border-radius:var(--r);padding:40px;display:flex;flex-direction:column;justify-content:space-between;min-height:420px}
.big-card .n{font-family:var(--num);font-size:clamp(90px,11vw,150px);line-height:.9;color:var(--gold)}
.big-card .n small{font-family:var(--serif);font-size:34px;color:#fff;margin-left:6px}
.big-card h3{font-size:30px;margin:14px 0 8px}
.big-card p{opacity:.85;margin:0}
.c-list{display:grid;gap:16px}
.c-item{background:#fff;border-radius:var(--r);padding:22px 26px;display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:center;box-shadow:0 1px 0 var(--line)}
.c-item .n{font-family:var(--num);font-size:46px;line-height:1;color:var(--rose);min-width:2.2ch;text-align:right}
.c-item .n small{font-family:var(--sans);font-size:15px;font-weight:900;color:var(--ink)}
.c-item h3{font-size:19px;margin:0}
.c-item p{margin:2px 0 0;font-size:15px;color:var(--muted)}
.partners{margin-top:30px;display:flex;flex-wrap:wrap;gap:10px}
.partners span{border:1.5px solid var(--ink);border-radius:999px;padding:5px 14px;font-size:14px;font-weight:700}
@media (max-width:900px){.charity{grid-template-columns:1fr}.big-card{min-height:0}}

/* service */
.svc{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:40px;border-top:2px solid var(--ink)}
.svc article{padding:28px 26px 30px 0;border-bottom:1px solid var(--line)}
.svc article:not(:nth-child(3n)){border-right:1px solid var(--line)}
.svc article:not(:nth-child(3n+1)){padding-left:26px}
.svc .cat{font-size:13px;font-weight:900;letter-spacing:.2em;color:var(--rose)}
.svc h3{font-size:22px;margin:6px 0 8px}
.svc p{margin:0;font-size:15.5px;color:var(--muted)}
.office{margin-top:60px;display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;background:#fff;border-radius:var(--r);padding:30px 34px;box-shadow:0 18px 40px -30px rgba(46,13,56,.6)}
.office .ic{width:70px;height:70px;border-radius:18px;background:var(--sunset);display:grid;place-items:center;color:#fff}
.office h3{margin:0;font-size:24px}
.office p{margin:2px 0 0;color:var(--muted)}
.award{display:inline-block;margin-bottom:6px;font-size:13px;font-weight:900;background:var(--gold);padding:3px 12px;border-radius:999px}
@media (max-width:900px){.svc{grid-template-columns:1fr}.svc article{border-right:0!important;padding-left:0!important}.office{grid-template-columns:1fr}}

/* alumni */
.alumni{background:#2e0d38;color:#fff;overflow:hidden}
.alumni::before{content:"";position:absolute;right:-20%;top:-30%;width:70%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(232,34,122,.35),transparent 65%);z-index:0}
.alumni .wrap{position:relative;z-index:2}
.al-top{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
.alumni .eyebrow{color:var(--gold)}.alumni .eyebrow::before{background:var(--gold)}
.alumni h2 em{font-style:normal;color:var(--gold)}
.alumni .lead{color:rgba(255,255,255,.82)}
.gift{position:relative;margin:0}
.gift img{width:100%;height:auto;aspect-ratio:1;object-fit:cover;border-radius:24px}
.gift .q{position:absolute;left:-14px;bottom:-14px;white-space:nowrap;background:var(--gold);color:var(--ink);font-weight:900;padding:10px 18px;border-radius:12px;transform:rotate(-4deg);font-size:17px}
.paths{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:60px}
.path{border-radius:22px;padding:36px 34px;display:flex;flex-direction:column;gap:14px}
.path.east{background:var(--sunset)}
.path.far{background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.22)}
.path .who{font-size:14px;font-weight:900;letter-spacing:.2em}
.path h3{font-size:32px;margin:0}
.path p{margin:0;opacity:.92}
.path ol{margin:0;padding-left:1.3em;opacity:.95}
.path ol li{margin:4px 0}
.path .btns{margin-top:auto;padding-top:10px}
.cheer-out{min-height:1.6em;font-weight:700;color:var(--gold)}
.al-links{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:22px}
.al-link{display:flex;align-items:center;justify-content:space-between;gap:20px;text-decoration:none;color:#fff;background:rgba(255,255,255,.05);border-radius:18px;padding:24px 28px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);transition:background .2s}
.al-link:hover{background:rgba(255,255,255,.11)}
.al-link small{display:block;color:var(--gold);font-weight:900;letter-spacing:.18em;font-size:12px}
.al-link b{font-size:21px;font-family:var(--serif)}
.al-link span.t{display:block;font-size:14px;opacity:.75}
.al-link svg{width:30px;height:30px;flex:none}
@media (max-width:900px){.al-top,.paths,.al-links{grid-template-columns:1fr}.gift{max-width:420px}}

/* final */
.final{background:var(--sunset);color:#fff;text-align:center;overflow:hidden}
.final::before{content:"";position:absolute;inset:-50%;background:repeating-conic-gradient(from 0deg at 50% 100%,rgba(255,255,255,.12) 0deg 5deg,transparent 5deg 14deg);z-index:0}
.final .wrap{position:relative;z-index:2}
.final .d{font-family:var(--num);font-size:clamp(120px,22vw,300px);line-height:.85;text-shadow:8px 8px 0 var(--ink)}
.final h2{color:#fff;margin-top:20px}
