<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.coach.tra-inbox-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bymyway/.openclaw/workspace/scripts/tra_inbox_worker.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/Users/bymyway/.openclaw/workspace/state/tra_research_inbox.md</string>
