<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.llama-memory-guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bymyway/.openclaw/workspace/scripts/llama_memory_guard.sh</string>
    </array>
    <!-- 事件觸發：外掛被更新（新資料夾／原檔被覆蓋）或設定檔被改寫，當下就跑 -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/bymyway/.openclaw/npm/projects</string>
        <string>/Users/bymyway/.openclaw/npm/projects/openclaw-llama-cpp-provider-15b2d859e6__openclaw-generation__g-5ecf1d6216a147e6/node_modules/@openclaw/llama-cpp-provider/dist/index.js</string>
        <string>/Users/bymyway/.openclaw/tools/llama.cpp</string>
    </array>
    <!-- 保底：每天 05:10 量一次記憶體（跟 RustDesk 守衛 05:00 同一套） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/bymyway/.openclaw/workspace/logs/llama_memory_guard_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bymyway/.openclaw/workspace/logs/llama_memory_guard_stderr.log</string>
</dict>
</plist>
