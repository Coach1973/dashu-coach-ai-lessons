r-radius: 4px; padding: 13px 15px; font-size: 14px;\n413\t  color: var(--text); font-family: inherit; outline: none;\n414\t  transition: border-color var(--ease);\n415\t}\n416\t.subscribe-form input:focus { border-color: var(--gold); }\n417\t.subscribe-form input::placeholder { color: var(--muted); }\n418\t.subscribe-form button {\n419\t  width: 100%; padding: 14px; background: var(--gold); color: #0c0c0c;\n420\t  border: none; border-radius: 4px; font-weight: 700; font-size: 15px;\n421\t  cursor: pointer; font-family: inherit; transition: background var(--ease);\n422\t}\n423\t.subscribe-form button:hover { background: var(--gold-light); }\n424\t.sub-note { font-size: 12px; color: var(--muted); margin-top: 10px; line-height: 1.6; }\n425\t\n426\t/* ===== FOOTER ===== */\n427\t.footer { background: var(--dark); border-top: 1px solid rgba(200,169,110,0.1); padding: 68px 0 0; }\n428\t.footer-inner { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 48px; }\n429\t.footer-brand .logo-main { font-family: 'Noto Serif TC', serif; font-size: 21px; font-weight: 900; color: var(--gold); letter-spacing: 3px; display: block; }\n430\t.footer-brand .logo-sub { font-size: 10px; letter-spacing: 2px; color: var(--muted); display: block; margin-bottom: 14px; }\n431\t.footer-brand p { font-size: 13px; color: var(--muted); line-height: 1.8; }\n432\t.footer-identity { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }\n433\t.footer-identity span { font-size: 12px; color: rgba(200,169,110,0.6); }\n434\t.footer-col h4 { font-size: 12px; letter-spacing: 2px; color: var(--gold); margin-bottom: 14px; text-transform: uppercase; }\n435\t.footer-col { display: flex; flex-direction: column; }\n436\t.footer-col a { font-size: 13px; color: var(--muted); padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.04); transition: color var(--ease); }\n437\t.footer-col a:hover { color: var(--gold); }\n438\t.footer-bottom { border-top: 1px solid rgba(