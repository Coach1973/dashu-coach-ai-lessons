  font-family: inherit;\n68\t}\n69\t.btn-gold:hover { background: var(--gold-light); transform: translateY(-2px); }\n70\t\n71\t.btn-line {\n72\t  display: inline-block;\n73\t  border: 2px solid var(--gold);\n74\t  color: var(--gold);\n75\t  padding: 12px 32px;\n76\t  border-radius: 4px;\n77\t  font-weight: 700;\n78\t  font-size: 15px;\n79\t  letter-spacing: 1px;\n80\t  transition: all var(--ease);\n81\t}\n82\t.btn-line:hover { background: var(--gold); color: #0c0c0c; transform: translateY(-2px); }\n83\t\n84\t.btn-outline {\n85\t  display: inline-block;\n86\t  border: 2px solid rgba(200,169,110,0.5);\n87\t  color: var(--gold);\n88\t  padding: 12px 32px;\n89\t  border-radius: 4px;\n90\t  font-weight: 700;\n91\t  font-size: 15px;\n92\t  transition: all var(--ease);\n93\t}\n94\t.btn-outline:hover { border-color: var(--gold); background: rgba(200,169,110,0.08); }\n95\t\n96\t.hero-btns { display: flex; gap: 16px; flex-wrap: wrap; }\n97\t\n98\t/* ===== NAVBAR ===== */\n99\t.navbar {\n100\t  position: fixed; top: 0; left: 0; right: 0;\n101\t  z-index: 1000;\n102\t  transition: background var(--ease), box-shadow var(--ease);\n103\t}\n104\t.navbar.scrolled {\n105\t  background: rgba(12,12,12,0.97);\n106\t  box-shadow: 0 2px 24px rgba(0,0,0,0.6);\n107\t}\n108\t.nav-inner {\n109\t  display: flex; align-items: center;\n110\t  justify-content: space-between;\n111\t  height: 70px;\n112\t}\n113\t.logo { display: flex; flex-direction: column; line-height: 1.1; }\n114\t.logo-main {\n115\t  font-family: 'Noto Serif TC', serif;\n116\t  font-size: 20px; font-weight: 900;\n117\t  color: var(--gold); letter-spacing: 3px;\n118\t}\n119\t.logo-sub { font-size: 10px; letter-spacing: 2px; color: var(--muted); margin-top: 1px; }\n120\t\n121\t.nav-links { display: flex; align-items: center; gap: 28px; }\n122\t.nav-links a {\n123\t  font-size: 14px; color: var(--text);\n124\t  letter-spacing: 1px;\n125\t  position: relative;\n126\t  transition: color var(--ease);\n127\t}\n128\t.nav-links a::after