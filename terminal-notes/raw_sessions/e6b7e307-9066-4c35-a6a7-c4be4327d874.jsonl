\n698\t      <path d=\"M24 9C16.268 9 10 14.477 10 21c0 3.99 2.238 7.52 5.698 9.82-.252.914-.811 2.922-.929 3.379-.145.564.206.557.434.406.177-.118 2.82-1.914 3.962-2.692.892.125 1.81.192 2.835.192 7.732 0 14-5.477 14-12S31.732 9 24 9z\" fill=\"white\"/>\n699\t      <text x=\"15\" y=\"26\" font-family=\"Arial\" font-size=\"9\" font-weight=\"bold\" fill=\"#06C755\">LINE</text>\n700\t    </svg>\n701\t  </a>\n702\t\n703\t  <script src=\"main.js\"></script>\n704\t</body>\n705\t</html>\n706\t"}]},"uuid":"4491d8e4-71c4-4dc8-9d66-4d79dee6dc5a","timestamp":"2026-06-14T06:44:16.482Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/bymyway/github_repos/bymyway-website/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-TW\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>大樹教練 吳大樹 ｜ 有效溝通就是無價之寶</title>\n  <meta name=\"description\" content=\"大樹教練吳大樹，投入教育25年，演講超過5,000場，足跡遍及台灣、新加坡、馬來西亞及中國大陸。海餅乾俱樂部創辦人，BNI大台南南區執行董事，頂級特助系統創建者。\" />\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&family=Noto+Sans+TC:wght@300;400;500;700&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <!-- 導覽列 -->\n  <header class=\"navbar\" id=\"navbar\">\n    <div class=\"container nav-inner\">\n      <a href=\"#\" class=\"logo\">\n        <span class=\"logo-main\">大樹教練</span>\n        <span class=\"logo-sub\">吳大樹 DA SHU COACH</span>\n      </a>\n      <nav class=\"nav-links\">\n        <a href=\"#about\">關於教練</a>\n        <a href=\"#timeline\">創業歷程</a>\n        <a href=\"#services\">服務項目</a>\n        <a href=\"#courses\">線上課程</a>\n        <a href=\"#speaking\">企業演講</a>\n        <a href=\"#contact\" class=\"btn-nav\">立即聯繫</a>\n      </nav>\n      <button class=\"hamburger\" id=\"hamburger\" aria-label=\"選單\">\n        <span></span><span></span><span></span>\n      </button>\n    </div>\n    <div class=\"mobile-menu\" id=\"mobileMenu\">\n      <a href=\"#about\">關於教練</a>\n      <a href=\"#timeline\">創業歷程</a>\n      <a href=\"#services\">服務項目</a>\n      <a href=\"#courses\">線上課程</a>\n      <a href=\"#speaking\">企業演講</a>\n      <a href=\"#contact\">立即聯繫</a>\n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"container hero-content\">\n      <p class=\"hero-tag\">投入教育 25 年｜演講超過 5,000 場</p>\n      <h1 class=\"hero-title\">有效溝通<br><span class=\"gold\">就是無價之寶</span></h1>\n      <p class=\"hero-desc\">\n        協助每一個生命值得更好的人<br>\n        在人生每個階段，找到自我價值、展現最佳狀態\n      </p>\n      <div class=\"hero-btns\">\n        <a href=\"#courses\" class=\"btn-gold\">探索線上課程</a>\n        <a href=\"#contact\" class=\"btn-line\">邀約演講培訓</a>\n      </div>\n    </div>\n    <div class=\"scroll-hint\"><span></span></div>\n  </section>\n\n  <!-- 痛點 -->\n  <section class=\"pain\" id=\"pain\">\n    <div class=\"container\">\n      <p class=\"tag center\">你是否也面臨這樣的困境？</p>\n      <div class=\"pain-grid\">\n        <div class=\"pain-card\">\n          <div class=\"pain-icon\">💼</div>\n          <h3>職場瓶頸</h3>\n          <p>努力工作卻晉升無望，不知道如何突破職涯天花板？</p>\n        </div>\n        <div class=\"pain-card\">\n          <div class=\"pain-icon\">🗣️</div>\n          <h3>溝通障礙</h3>\n          <p>開口說話就緊張，人際關係複雜，無法有效表達自己？</p>\n        </div>\n        <div class=\"pain-card\">\n          <div class=\"pain-icon\">📉</div>\n          <h3>業績低迷</h3>\n          <p>銷售屢屢碰壁，客戶一再拒絕，找不到開單的核心關鍵？</p>\n        </div>\n        <div class=\"pain-card\">\n          <div class=\"pain-icon\">🔍</div>\n          <h3>迷失方向</h3>\n          <p>不清楚自己的優勢與潛能，不知道該往哪個方向前進？</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 數據條 -->\n  <section class=\"stats\">\n    <div class=\"container stats-grid\">\n      <div class=\"stat-item\">\n        <span class=\"stat-num\" data-target=\"25\">0</span><span class=\"stat-unit\">年</span>\n        <span class=\"stat-label\">培訓教育資歷</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-num\" data-target=\"5000\">0</span><span class=\"stat-unit\">+ 場</span>\n        <span class=\"stat-label\">演講場次</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-num\" data-target=\"100000\">0</span><span class=\"stat-unit\">+ 人</span>\n        <span class=\"stat-label\">受益學員</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-num\" data-target=\"4\">0</span><span class=\"stat-unit\">地</span>\n        <span class=\"stat-label\">台灣・新馬・中國大陸</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- 關於教練 -->\n  <section class=\"about\" id=\"about\">\n    <div class=\"container about-inner\">\n      <div class=\"about-photo\">\n        <img\n          src=\"https://www.bymyway.com/wp-content/uploads/2024/dashu-coach-profile.jpg\"\n          alt=\"大樹教練 吳大樹\"\n          onerror=\"this.style.display='none'; this.nextElementSibling.style.display='flex'\"\n        />\n        <div class=\"photo-fallback\">大樹<br>教練</div>\n        <div class=\"photo-badge\">零負評<br>培訓講師</div>\n      </div>\n      <div class=\"about-text\">\n        <p class=\"tag\">關於大樹教練</p>\n        <h2>吳大樹<br><span class=\"gold\">具有使命感的教育家</span></h2>\n        <blockquote>\n          「每次課程都要將最好的訊息，帶給每一個生命值得更好的人。」\n        </blockquote>\n        <p>大樹教練投入教育二十五年，洞悉人性，深耕人際關係與自我成長領域。演講足跡遍佈臺灣、中國大陸主要城市、馬來西亞、新加坡，受益學員超過十萬人次。</p>\n        <p>業界少數<strong>零負評培訓講師</strong>，用最淺白的語言與啟發的方式，引導學員找到根源性問題的解決方案。</p>\n\n        <div class=\"identity-tags\">\n          <span>🎯 海餅乾俱樂部創辦人（2007）</span>\n          <span>🏢 BNI 大台南南區執行董事</span>\n          <span>📚 人才培育系統創辦人</span>\n        </div>\n\n        <div class=\"about-skills\">\n          <span>有效溝通</span>\n          <span>人際關係</span>\n          <span>發現潛能</span>\n          <span>突破設限</span>\n          <span>銷售力</span>\n        </div>\n        <a href=\"#contact\" class=\"btn-gold\">與大樹教練聯繫</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 創業歷程 -->\n  <section class=\"timeline\" id=\"timeline\">\n    <div class=\"container\">\n      <p class=\"tag center\">創業歷程</p>\n      <h2 class=\"section-title center\">從 1997 年至今<br><span class=\"gold\">27 年的創業與教育之路</span></h2>\n      <div class=\"timeline-track\">\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">1997</span>\n          <div class=\"tl-content\">\n            <h4>尋易電信</h4>\n            <p>店東｜踏上創業之路</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">1998</span>\n          <div class=\"tl-content\">\n            <h4>叢林美工廣告股份有限公司</h4>\n            <p>業務副總</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">1999</span>\n          <div class=\"tl-content\">\n            <h4>陳安之研究訓練機構</h4>\n            <p>課程助教／助理講師｜正式踏入教育培訓領域</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2002</span>\n          <div class=\"tl-content\">\n            <h4>中華數位教育發展協會</h4>\n            <p>秘書長</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2005</span>\n          <div class=\"tl-content\">\n            <h4>心想事成國際股份有限公司</h4>\n            <p>共同創辦人</p>\n          </div>\n        </div>\n        <div class=\"tl-item highlight\">\n          <span class=\"tl-year\">2007</span>\n          <div class=\"tl-content\">\n            <h4>海餅乾俱樂部</h4>\n            <p>創辦人｜一個使命，三大信念，十條守則</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2015</span>\n          <div class=\"tl-content\">\n            <h4>桃園東陽扶輪社</h4>\n            <p>創始會員／節目主委</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2016</span>\n          <div class=\"tl-content\">\n            <h4>希望之聲全球廣播電臺</h4>\n            <p>節目企劃</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2017</span>\n          <div class=\"tl-content\">\n            <h4>大樹教育顧問有限公司</h4>\n            <p>創辦人</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2018</span>\n          <div class=\"tl-content\">\n            <h4>聚寶盆商業顧問有限公司</h4>\n            <p>創辦人</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2018</span>\n          <div class=\"tl-content\">\n            <h4>BNI 大台南南區</h4>\n            <p>執行董事</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2022</span>\n          <div class=\"tl-content\">\n            <h4>中華中小企業跨業交流協會</h4>\n            <p>常務監事</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2023</span>\n          <div class=\"tl-content\">\n            <h4>大臺南生命線協會</h4>\n            <p>總幹事</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-year\">2024</span>\n          <div class=\"tl-content\">\n            <h4>全球健康發展協會</h4>\n            <p>公益財源開拓委員會主委</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 智慧語錄 -->\n  <section class=\"quotes-carousel\" id=\"quotes\">\n    <div class=\"container\">\n      <p class=\"tag center\">智慧語錄</p>\n      <h2 class=\"section-title center\">大樹教練的<span class=\"gold\">經典金句</span></h2>\n\n      <div class=\"carousel-wrapper\">\n        <button class=\"carousel-btn carousel-prev\" id=\"qPrev\">‹</button>\n\n        <div class=\"carousel-viewport\">\n          <div class=\"carousel-track\" id=\"qTrack\">\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">你是誰，決定了別人怎麼看你；而不是，別人怎麼看你，決定了你是誰。</p>\n              <span class=\"card-tag\">自我認同</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">要麼你去駕馭生命，要麼是生命駕馭你。你的心態決定誰是坐騎，誰是騎師。</p>\n              <span class=\"card-tag\">心態掌控</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">開始承認自己不懂不會，就代表開始成長了。</p>\n              <span class=\"card-tag\">成長心態</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">你沒有的東西，你無法給別人。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">沒有內功，就沒有威力。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">「誤解」比「不懂」更可怕。</p>\n              <span class=\"card-tag\">學習觀念</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">證明自己是對的，有時候是一種很大的內耗。</p>\n              <span class=\"card-tag\">人生智慧</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">我要證明，這句話不用說，當你做到時就已經証明了。</p>\n              <span class=\"card-tag\">行動力</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">如果你不掌控就會失控。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">所有的結果都是你同意後的結果。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">自信是決定，決定完就結束了。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">自信是 100%，少一點都不是。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">下決定然後負責任。</p>\n              <span class=\"card-tag\">自信心</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">所有的話都是半句話。</p>\n              <span class=\"card-tag\">溝通智慧</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">你為何而來，就會因何而走。只有一種情況你會一直留下來：你是因為理念相同而來。只要理念不變，你也沒有理由離開。</p>\n              <span class=\"card-tag\">海餅乾俱樂部</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">培育人才，創造奇蹟，做對社會有貢獻的事。</p>\n              <span class=\"card-tag\">海餅乾使命</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">100% 為自己的生命負責。</p>\n              <span class=\"card-tag\">海餅乾守則</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">態度一流、思想積極、高度意願、形象良好、全力以赴、自動自發、凡事付出、最佳狀態、一定準時、每天快樂！</p>\n              <span class=\"card-tag\">海餅乾十條守則</span>\n            </div>\n\n            <div class=\"carousel-card\">\n              <span class=\"card-quote-mark\">❝</span>\n              <p class=\"card-text\">人們經常處於：知道，做不到。我們的目標是：知道，做到。最終的境界要：不知道，做到。</p>\n              <span class=\"card-tag\">知行合一</span>\n            </div>\n\n          </div>\n        </div>\n\n        <button class=\"carousel-btn carousel-next\" id=\"qNext\">›</button>\n      </div>\n\n      <div class=\"carousel-dots\" id=\"qDots\"></div>\n      <div class=\"carousel-nav-bottom\">\n        <button class=\"carousel-nav-btn\" id=\"qPrevBottom\">‹ 上一句</button>\n        <span class=\"carousel-counter\" id=\"qCounter\">1 / 19</span>\n        <button class=\"carousel-nav-btn\" id=\"qNextBottom\">下一句 ›</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- 服務項目 -->\n  <section class=\"services\" id=\"services\">\n    <div class=\"container\">\n      <p class=\"tag center\">核心服務</p>\n      <h2 class=\"section-title center\">找到你的核心競爭力<br><span class=\"gold\">人生每個角色都能發光</span></h2>\n      <div class=\"services-grid\">\n        <div class=\"service-card\">\n          <div class=\"svc-num\">01</div>\n          <h3>企業培訓</h3>\n          <p>為企業量身設計課程，提升團隊溝通力、銷售力與凝聚力。從根源解決問題，讓每位員工發揮最大潛能。</p>\n          <ul>\n            <li>溝通與人際關係</li>\n            <li>業務銷售技巧</li>\n            <li>領導力與團隊建立</li>\n            <li>自我潛能開發</li>\n          </ul>\n          <a href=\"#contact\" class=\"svc-link\">了解更多 →</a>\n        </div>\n        <div class=\"service-card featured\">\n          <div class=\"svc-num\">02</div>\n          <h3>線上課程</h3>\n          <p>隨時隨地學習，25 年精華濃縮成影音課程。從溝通技巧、自信建立到核心競爭力，全方位提升個人價值。</p>\n          <ul>\n            <li>溝通的藝術</li>\n            <li>無與倫比的自信</li>\n            <li>人類六項需求</li>\n            <li>核心競爭力找尋</li>\n          </ul>\n          <a href=\"#courses\" class=\"svc-link\">查看課程 →</a>\n        </div>\n        <div class=\"service-card\">\n          <div class=\"svc-num\">03</div>\n          <h3>個人教練</h3>\n          <p>一對一深度陪伴，針對你的具體困境制定專屬成長方案。從自我認識到行動改變，大樹教練與你同行。</p>\n          <ul>\n            <li>個人職涯規劃</li>\n            <li>人際關係梳理</li>\n            <li>自我潛能探索</li>\n            <li>行動方案設計</li>\n          </ul>\n          <a href=\"#contact\" class=\"svc-link\">預約諮詢 →</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 線上課程 -->\n  <section class=\"courses\" id=\"courses\">\n    <div class=\"container\">\n      <p class=\"tag center\">線上課程</p>\n      <h2 class=\"section-title center\">25 年精華<br><span class=\"gold\">濃縮成你隨時可學的課程</span></h2>\n      <div class=\"courses-grid\">\n        <div class=\"course-card\">\n          <div class=\"course-cover c1\"><span>溝通<br>的藝術</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>人際力</span><span>溝通力</span><span>銷售力</span></div>\n            <h3>溝通的藝術</h3>\n            <p>38 分鐘｜掌握溝通核心，讓每一次表達都有效果</p>\n            <div class=\"course-price\"><b>NT$ 1,688</b><s>NT$ 2,980</s></div>\n            <a href=\"https://www.bymyway.com/courses/%e6%ba%9d%e9%80%9a%e7%9a%84%e8%97%9d%e8%a1%93/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n        <div class=\"course-card\">\n          <div class=\"course-cover c2\"><span>無與倫比<br>的自信</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>競爭力</span></div>\n            <h3>擁有無與倫比的自信</h3>\n            <p>26 分鐘｜從內而外建立不動如山的自信心</p>\n            <div class=\"course-price\"><b>NT$ 1,980</b><s>NT$ 3,980</s></div>\n            <a href=\"https://www.bymyway.com/courses/%e6%93%81%e6%9c%89%e7%84%a1%e8%88%87%e5%80%ab%e6%af%94%e7%9a%84%e8%87%aa%e4%bf%a1/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n        <div class=\"course-card\">\n          <div class=\"course-cover c3\"><span>人類<br>六項需求</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>人際力</span><span>溝通力</span><span>競爭力</span></div>\n            <h3>人類六項需求</h3>\n            <p>1小時 27分｜了解人性底層需求，掌握人際關鍵</p>\n            <div class=\"course-price\"><b>NT$ 999</b><s>NT$ 2,980</s></div>\n            <a href=\"https://www.bymyway.com/courses/%e4%ba%ba%e9%a1%9e%e5%85%ad%e9%a0%85%e9%9c%80%e6%b1%82/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n        <div class=\"course-card\">\n          <div class=\"course-cover c4\"><span>核心<br>競爭力</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>競爭力</span></div>\n            <h3>如何找到你的核心競爭力</h3>\n            <p>找到你獨一無二的優勢，在競爭中脫穎而出</p>\n            <div class=\"course-price\"><b>NT$ 2,980</b><s>NT$ 8,600</s></div>\n            <a href=\"https://www.bymyway.com/courses/%e5%a6%82%e4%bd%95%e6%89%be%e5%88%b0%e4%bd%a0%e7%9a%84%e6%a0%b8%e5%bf%83%e7%ab%b6%e7%88%ad%e5%8a%9b/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n        <div class=\"course-card\">\n          <div class=\"course-cover c5\"><span>最佳<br>狀態</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>人際力</span><span>競爭力</span></div>\n            <h3>如何隨時進入最佳狀態？</h3>\n            <p>掌握狀態切換關鍵，隨時保持巔峰表現</p>\n            <div class=\"course-price\"><b>NT$ 2,980</b><s>NT$ 3,980</s></div>\n            <a href=\"https://www.bymyway.com/courses/%e5%a6%82%e4%bd%95%e9%9a%a8%e6%99%82%e5%85%a5%e6%9c%80%e4%bd%b3%e7%8b%80%e6%85%8b%ef%bc%9f/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n        <div class=\"course-card\">\n          <div class=\"course-cover c6\"><span>擁抱<br>拒絕</span></div>\n          <div class=\"course-body\">\n            <div class=\"course-tags\"><span>銷售力</span></div>\n            <h3>擁抱拒絕俱樂部</h3>\n            <p>35 分鐘｜把拒絕變成你最強大的銷售武器</p>\n            <div class=\"course-price\"><b>NT$ 1,980</b></div>\n            <a href=\"https://www.bymyway.com/courses/%e6%93%81%e6%8a%b1%e6%8b%92%e7%b5%95%e4%bf%b1%e6%a8%82%e9%83%a8/\" target=\"_blank\" class=\"btn-course\">立即購課</a>\n          </div>\n        </div>\n      </div>\n      <div class=\"center mt-40\">\n        <a href=\"https://www.bymyway.com/courses\" target=\"_blank\" class=\"btn-outline\">查看全部課程</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 企業演講 -->\n  <section class=\"speaking\" id=\"speaking\">\n    <div class=\"container\">\n      <p class=\"tag center\">企業培訓｜活動演講</p>\n      <h2 class=\"section-title center\">邀請大樹教練<br><span class=\"gold\">為你的團隊帶來改變</span></h2>\n      <div class=\"speaking-grid\">\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">🎯</div>\n          <h3>溝通與人際關係</h3>\n          <p>有效溝通技巧、人際衝突處理、跨部門協作</p>\n        </div>\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">💪</div>\n          <h3>自信與心理建設</h3>\n          <p>建立正向心態、突破自我設限、提升自我效能</p>\n        </div>\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">🚀</div>\n          <h3>銷售與業績提升</h3>\n          <p>銷售心理學、拒絕處理技巧、成交率倍增策略</p>\n        </div>\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">🌱</div>\n          <h3>潛能開發與成長</h3>\n          <p>發現核心優勢、制定成長路徑、實現人生目標</p>\n        </div>\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">👥</div>\n          <h3>團隊領導與激勵</h3>\n          <p>領導力建立、團隊文化塑造、員工激勵方法</p>\n        </div>\n        <div class=\"speaking-card\">\n          <div class=\"sp-icon\">📖</div>\n          <h3>品德教育與傳統文化</h3>\n          <p>以中華傳統文化為核心動力，培育品德與正向價值觀</p>\n        </div>\n      </div>\n      <div class=\"speaking-footer\">\n        <p>已服務超過 <strong>200 家</strong>企業與機構</p>\n        <a href=\"#contact\" class=\"btn-gold\">立即邀約演講</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 學員見證 -->\n  <section class=\"testimonials\">\n    <div class=\"container\">\n      <p class=\"tag center\">學員見證</p>\