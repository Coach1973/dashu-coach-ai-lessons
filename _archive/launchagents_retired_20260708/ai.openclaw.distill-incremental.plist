<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.distill-incremental</string>
    <key>Comment</key>
    <string>Distill incremental: 每 2 小時蒸餾今日對話（從 cron 遷移 2026-06-05）</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bymyway/.openclaw/workspace/scripts/run_distill.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/distill_cron.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/distill_cron.error.log</string>
</dict>
</plist>
