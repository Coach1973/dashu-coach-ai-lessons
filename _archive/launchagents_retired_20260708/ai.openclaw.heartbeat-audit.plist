<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.heartbeat-audit</string>
    <key>Comment</key>
    <string>Heartbeat audit: 每天 23:50 掃 HEARTBEAT.md 純 OK 心跳數（從 cron 遷移 2026-06-05）</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bymyway/.openclaw/workspace/scripts/heartbeat_audit.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>50</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/heartbeat_audit.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/heartbeat_audit.error.log</string>
</dict>
</plist>
